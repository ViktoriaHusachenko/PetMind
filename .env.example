# Copy to .env (never commit .env). Real environment variables override this file.

# --- Database / ports ---
POSTGRES_DB=petly
POSTGRES_USER=petly
POSTGRES_PASSWORD=petly
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://petly:petly@127.0.0.1:5432/petly
# One source of truth for the API port: backend, Vite proxy and scripts/start-local.ps1 read it.
API_PORT=8000
FRONTEND_PORT=5173
PETMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Accounts ---
PETMIND_AUTH_SECRET=replace-with-a-long-random-secret
PETMIND_ADMIN_EMAIL=admin@petmind.local
PETMIND_ADMIN_PASSWORD=PetMindAdmin2026!
# Password for the seeded demo owners (Мурчик, Річі)
PETMIND_DEMO_PASSWORD=PetMindDemo2026!

# --- LLM ---
# Active provider: gemini | openai | anthropic | ollama | disabled
LLM_PROVIDER=gemini
# Implemented providers stay switched off unless listed here (comma-separated).
LLM_ENABLED_PROVIDERS=gemini
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model aliases track Google's current free-tier models; pin a version if needed.
LLM_CHAT_MODEL=gemini-flash-lite-latest
LLM_RERANK_MODEL=gemini-flash-lite-latest
# Client-side budgets; keep them at or below your free-tier quota.
LLM_CHAT_RPM=10
LLM_CHAT_RPD=400
LLM_RERANK_RPM=5
LLM_RERANK_RPD=200
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_BREAKER_FAILURES=3
LLM_BREAKER_COOLDOWN_SECONDS=60
LLM_CACHE_PATH=.cache/petrec_llm_cache.json

# Disabled providers (enable via LLM_ENABLED_PROVIDERS + LLM_PROVIDER)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Recommendations ---
# Profile, purchase and catalog changes invalidate the cache immediately.
RECOMMENDATION_TTL_SECONDS=600

# Optional API URL for the live end-to-end suite
PETMIND_API_URL=http://localhost:8000
